    {
      "name": "pdf-annotations",
      "description": "在 PDF 上做标注：矩形、圆形、自由笔、文字选区高亮，还能钉批注",
      "releases": [
        {
          "version": "0.2.0",
          "apiVersion": 2,
          "url": "https://github.com/rainbowinter/fwinterhuajian-plugins/releases/download/plugin-pdf-annotations-v0.2.0/pdf-annotations-0.2.0.zip",
          "sha256": "6806f68cc6928627908a0a46fb9a80a5f950525ce691b06e1d868c525b5ed59e",
          "size": 228068,
          "permissions": [
