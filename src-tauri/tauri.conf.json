{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "花笺",
  "version": "2.1.2",
  "identifier": "com.floral-notepaper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/kill-local-build.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "花笺",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "resources": {
      "../example-plugins-v2": "example-plugins-v2",
      "../Docs/user": "docs",
      "../src/styles/custom.css": "templates/custom.css"
    },
    "createUpdaterArtifacts": true,
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document file",
        "role": "Editor"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Text Document",
        "description": "Plain text file",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "Floral Notepaper - lightweight local note app",
      "args": []
    },
    "updater": {
      "endpoints": [
        "https://github.com/rainbowinter/huajiangongzuoqu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENDc3QjNFMjUxMTZFMDMKUldRRGJoRWxQbnRIbmZCR1EzUUpKcG54NjZEWWFFN1dxUEcvUGQ0ZHdveWpab2Y0UmZaaWpWOWIK"
    },
    "market": {
      "endpoints": [
        "https://github.com/rainbowinter/fwinterhuajian-plugins/releases/download/catalog/plugin-catalog.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENDc3QjNFMjUxMTZFMDMKUldRRGJoRWxQbnRIbmZCR1EzUUpKcG54NjZEWWFFN1dxUEcvUGQ0ZHdveWpab2Y0UmZaaWpWOWIK"
    }
  }
}
