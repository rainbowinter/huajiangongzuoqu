{
  "name": "note-stats",
  "version": "1.0.1",
  "apiVersion": 2,
  "main": "index.js",
  "description": "演示事件总线与插件级持久化：记录本次会话的笔记变化次数并跨重启保留",
  "author": "花笺",
  "permissions": [
    "events",
    "storage",
    "ui:panel",
    "ui:toast"
  ],
  "contributes": {
    "settings": [
      {
        "key": "notifyOnSave",
        "type": "boolean",
        "title": "保存时提示",
        "description": "每次笔记保存后弹一个 Toast",
        "default": false
      }
    ]
  },
  "icon": "icon.svg"
}
