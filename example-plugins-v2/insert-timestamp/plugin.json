{
  "name": "insert-timestamp",
  "version": "1.0.0",
  "apiVersion": 2,
  "main": "index.js",
  "description": "演示键位绑定与编辑器写入：一个快捷键插入当前时间，一个右键菜单项包裹选中文本",
  "author": "花笺",
  "permissions": ["ui:command", "ui:menus", "editor:write"],
  "contributes": {
    "settings": [
      {
        "key": "format",
        "type": "select",
        "title": "时间格式",
        "options": [
          { "value": "datetime", "label": "2026-10-14 09:30:00" },
          { "value": "date", "label": "2026-10-14" },
          { "value": "iso", "label": "2026-10-14T09:30:00" }
        ],
        "default": "datetime"
      }
    ]
  }
}
